<%- include('partials/head') %>
<%- include('partials/nav') %>
<section class="hero">
  <div class="hero-inner">
    <h1>Welcome to Simple Shop</h1>
    <p>Discover curated essentials for your everyday.</p>
    <a class="btn" href="/products">Shop now</a>
  </div>
</section>
<section>
  <h2>Featured products</h2>
  <div class="grid">
    <% products.slice(0, 3).forEach(p => { %>
      <a class="card" href="/product/<%= p.id %>">
        <img src="<%= p.image_url %>" alt="<%= p.name %>" />
        <div class="card-body">
          <h3><%= p.name %></h3>
          <p class="price"><%= formatPrice(p.price_cents) %></p>
        </div>
      </a>
    <% }) %>
  </div>
</section>
<%- include('partials/footer') %>